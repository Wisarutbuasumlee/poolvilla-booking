# ---------------------------------------------------------------------------
# Copy to .env.local and adjust. Everything here has a working local default
# except AUTH_SECRET, which you must generate yourself.
# ---------------------------------------------------------------------------

# --- Ports ------------------------------------------------------------------
# 3200, not 3000. The ERP project on this machine runs its Vite dev server on
# 3000 and its API on 3001, and two dev servers on one port fail in a way that
# looks like a code bug: Next quietly moves to the next free port and the admin
# hostname below stops matching what the browser sends.
PORT=3200

# --- Site -------------------------------------------------------------------
# Public origin. Used for canonical URLs, sitemap, OG images and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# Comma-separated hostnames (including port) that serve the admin surface.
# Chrome resolves *.localhost to 127.0.0.1 with no /etc/hosts entry needed.
ADMIN_HOSTNAMES=admin.localhost:3200

# When true, /{locale}/admin also works on the public hostname. Convenience for
# environments where a subdomain cannot be set up. Keep false in production.
ENABLE_ADMIN_PATH_FALLBACK=true

# --- Database ---------------------------------------------------------------
# THIS PROJECT STARTS NO DATABASE. It connects to the MongoDB already running
# on this machine and keeps its own database inside it, so nothing here
# competes with the ERP stack for port 27017.
#
# directConnection=true tells the driver to talk to exactly this server and
# not to go looking for a replica set behind it.
MONGODB_URI=mongodb://localhost:27017/poolvilla?directConnection=true

# Multi-document transactions need a replica set, and the server above is a
# standalone, which cannot start one at all. Correctness does not depend on
# this: double booking is prevented by a unique index, not by transactions.
# See docs/DECISIONS.md D-003.
MONGODB_TRANSACTIONS=false

# --- Redis ------------------------------------------------------------------
# Optional. Used for rate limiting across processes. Left unset here because
# this project runs no containers; the limiter falls back to an in-process
# counter, which is correct for a single dev server.
REDIS_URL=

# --- Auth -------------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_TRUST_HOST=true

# --- Booking ----------------------------------------------------------------
# How long a booking holds calendar dates while awaiting payment.
BOOKING_HOLD_MINUTES=30

# Default deposit percentage. A villa may override it.
DEFAULT_DEPOSIT_PERCENT=30

# Shared secret for the hold-expiry sweeper route.
CRON_SECRET=change-me-in-production

# --- Storage ----------------------------------------------------------------
# Local disk adapter. Swap for S3/MinIO later without touching call sites.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads

# --- Notifications ----------------------------------------------------------
# Each channel is an adapter and is skipped when its variables are unset.
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PoolVilla <noreply@example.com>"

NOTIFY_LINE_ENABLED=false
LINE_NOTIFY_TOKEN=

NOTIFY_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Payment ----------------------------------------------------------------
# PromptPay target for the payment QR. Mobile number or national/tax ID.
PROMPTPAY_ID=0812345678
