# ---------------------------------------------------------------------------
# Copy to .env.local and adjust. Everything here has a working local default
# except AUTH_SECRET, which you must generate yourself.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# Public origin. Used for canonical URLs, sitemap, OG images and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated hostnames (including port) that serve the admin surface.
# Chrome resolves *.localhost to 127.0.0.1 with no /etc/hosts entry needed.
ADMIN_HOSTNAMES=admin.localhost:3000

# When true, /{locale}/admin also works on the public hostname. Convenience for
# environments where a subdomain cannot be set up. Keep false in production.
ENABLE_ADMIN_PATH_FALLBACK=true

# --- Database ---------------------------------------------------------------
# directConnection=true is required: without it the driver reads the replica set
# config from inside the container and cannot reach the host-mapped port.
MONGODB_URI=mongodb://localhost:27017/poolvilla?replicaSet=rs0&directConnection=true

# Multi-document transactions. Requires a replica set (docker-compose provides
# a single-node one). Correctness does not depend on this; it is a safety net.
MONGODB_TRANSACTIONS=true

# Credentials for the mongo container and mongo-express. Local only.
MONGO_EXPRESS_PORT=8081

# --- Redis ------------------------------------------------------------------
# Used for rate limiting and as an advisory lock during booking holds.
# The app falls back to an in-memory limiter when this is unset.
REDIS_URL=redis://localhost:6379

# --- Auth -------------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_TRUST_HOST=true

# --- Booking ----------------------------------------------------------------
# How long a booking holds calendar dates while awaiting payment.
BOOKING_HOLD_MINUTES=30

# Default deposit percentage. A villa may override it.
DEFAULT_DEPOSIT_PERCENT=30

# Shared secret for the hold-expiry sweeper route.
CRON_SECRET=change-me-in-production

# --- Storage ----------------------------------------------------------------
# Local disk adapter. Swap for S3/MinIO later without touching call sites.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads

# --- Notifications ----------------------------------------------------------
# Each channel is an adapter and is skipped when its variables are unset.
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PoolVilla <noreply@example.com>"

NOTIFY_LINE_ENABLED=false
LINE_NOTIFY_TOKEN=

NOTIFY_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Payment ----------------------------------------------------------------
# PromptPay target for the payment QR. Mobile number or national/tax ID.
PROMPTPAY_ID=0812345678
