# ---------------------------------------------------------------------------
# Copy to .env next to docker-compose.prod.yml on the server.
# Every value here is required; compose refuses to start without them.
# ---------------------------------------------------------------------------

# --- Images ---------------------------------------------------------------
REGISTRY=thaics
TAG=latest

# --- Public identity ------------------------------------------------------
# The real origin. Used for canonical URLs, sitemap, OG images and email links.
NEXT_PUBLIC_SITE_URL=https://example.com

# Hostname that serves the back office. Comma-separate if there is more than
# one. nginx forwards the Host header unchanged, so this must match exactly
# what visitors type, including a non-standard port if there is one.
ADMIN_HOSTNAMES=admin.example.com

# --- Database -------------------------------------------------------------
# Only take effect on a FRESH mongo_data volume. Keep them URL-safe: they are
# embedded in the connection string.
MONGO_USER=poolvilla
MONGO_PASS=change-me-letters-and-digits-only
MONGO_DB=poolvilla

# --- Secrets --------------------------------------------------------------
# npx auth secret
AUTH_SECRET=
# Guards the hold-expiry sweeper route.
CRON_SECRET=

# --- Booking --------------------------------------------------------------
BOOKING_HOLD_MINUTES=30
DEFAULT_DEPOSIT_PERCENT=30

# --- Payment --------------------------------------------------------------
PROMPTPAY_ID=

# --- Notifications --------------------------------------------------------
# Each channel is skipped when disabled, and a failure never blocks a booking.
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PoolVilla <noreply@example.com>"

NOTIFY_LINE_ENABLED=false
LINE_NOTIFY_TOKEN=

NOTIFY_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
